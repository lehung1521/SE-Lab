@model ASPNETWebAppMVCStudentApp.Models.Student
@{ ViewBag.Title = "Details"; }
<h2>Details</h2>
<dl class="dl-horizontal">
    <dt>First Name</dt>
    <dd>@Html.DisplayFor(m => Model.FirstName)</dd>
    <dt>Last Name</dt>
    <dd>@Html.DisplayFor(m => Model.LastName)</dd>
    <dt>Enrollment Date</dt>
    <dd>@Html.DisplayFor(m => Model.EnrollmentDate)</dd>
</dl>
<p>
    @Html.ActionLink("Edit", "Edit", new { id = Model.StudentID }) |
    @Html.ActionLink("Back to List", "Index")
</p>
