@model ASPNETWebAppMVCStudentApp.Models.CourseViewModel
@{ ViewBag.Title = "Student Report"; }
<h2>Student Report</h2>
@using (Html.BeginForm("Generate", "Report", FormMethod.Post))
{
    <div class="form-group">
        <label>Select Course:</label>
        @Html.DropDownListFor(m => m.SelectedCourseID, Model.Courses, new { @class = "form-control" })
    </div>
    <button type="submit" name="action" value="preview" formtarget="_blank" class="btn btn-primary">Print Preview</button>
    <button type="submit" name="action" value="export" class="btn btn-default">Export to PDF</button>
}
