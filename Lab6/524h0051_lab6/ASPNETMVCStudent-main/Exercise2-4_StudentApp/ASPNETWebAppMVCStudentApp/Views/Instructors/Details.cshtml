@model ASPNETWebAppMVCStudentApp.Models.Instructor
@{ ViewBag.Title = "Details"; }
<h2>Details</h2>
<dl class="dl-horizontal">
    <dt>First Name</dt>
    <dd>@Html.DisplayFor(m => Model.FirstName)</dd>
    <dt>Last Name</dt>
    <dd>@Html.DisplayFor(m => Model.LastName)</dd>
    <dt>Hire Date</dt>
    <dd>@Html.DisplayFor(m => Model.HireDate)</dd>
</dl>
<p>
    @Html.ActionLink("Edit", "Edit", new { id = Model.InstructorID }) |
    @Html.ActionLink("Back to List", "Index")
</p>
