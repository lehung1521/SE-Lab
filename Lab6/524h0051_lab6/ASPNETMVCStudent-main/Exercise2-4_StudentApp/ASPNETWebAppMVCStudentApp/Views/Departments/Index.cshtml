@model System.Collections.Generic.IEnumerable<ASPNETWebAppMVCStudentApp.Models.Department>
@{ ViewBag.Title = "Departments"; }
<h2>Departments</h2>
<p>@Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-primary" })</p>
<table class="table table-striped">
    <tr>
                <th>Name</th>
                <th>Budget</th>
                <th>Start Date</th>
        <th></th>
    </tr>
@foreach (var item in Model)
{
    <tr>
                <td>@Html.DisplayFor(m => item.Name)</td>
                <td>@Html.DisplayFor(m => item.Budget)</td>
                <td>@Html.DisplayFor(m => item.StartDate)</td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id = item.DepartmentID }) |
            @Html.ActionLink("Details", "Details", new { id = item.DepartmentID }) |
            @Html.ActionLink("Delete", "Delete", new { id = item.DepartmentID })
        </td>
    </tr>
}
</table>
