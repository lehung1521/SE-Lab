@model System.Collections.Generic.IEnumerable<ASPNETWebAppMVCStudentApp.Models.Enrollment>
@{ ViewBag.Title = "Enrollments"; }
<h2>Enrollments</h2>
<p>@Html.ActionLink("Create New", "Create", null, new { @class = "btn btn-primary" })</p>
<table class="table table-striped">
    <tr>
                <th>Course</th>
                <th>Student</th>
                <th>Grade</th>
        <th></th>
    </tr>
@foreach (var item in Model)
{
    <tr>
                <td>@Html.DisplayFor(m => item.Course.Title)</td>
                <td>@Html.DisplayFor(m => item.Student.FullName)</td>
                <td>@Html.DisplayFor(m => item.Grade)</td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id = item.EnrollmentID }) |
            @Html.ActionLink("Details", "Details", new { id = item.EnrollmentID }) |
            @Html.ActionLink("Delete", "Delete", new { id = item.EnrollmentID })
        </td>
    </tr>
}
</table>
