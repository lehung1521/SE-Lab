@model Course
@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>
<h4>Course</h4>
<hr />
<dl class="row">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@Model.CourseID</dd>
        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Model.Title</dd>
        <dt class="col-sm-3">Credits</dt>
        <dd class="col-sm-9">@Model.Credits</dd>
        <dt class="col-sm-3">Department</dt>
        <dd class="col-sm-9">@Model.Department?.DepartmentName</dd>
</dl>
<div>
    <a asp-action="Edit" asp-route-id="@Model.CourseID">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
