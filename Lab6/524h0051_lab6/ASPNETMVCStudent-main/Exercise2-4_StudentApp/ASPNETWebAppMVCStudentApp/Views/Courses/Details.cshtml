@model ASPNETWebAppMVCStudentApp.Models.Course
@{ ViewBag.Title = "Details"; }
<h2>Details</h2>
<dl class="dl-horizontal">
    <dt>Title</dt>
    <dd>@Html.DisplayFor(m => Model.Title)</dd>
    <dt>Credits</dt>
    <dd>@Html.DisplayFor(m => Model.Credits)</dd>
    <dt>Department</dt>
    <dd>@Html.DisplayFor(m => Model.Department.Name)</dd>
</dl>
<p>
    @Html.ActionLink("Edit", "Edit", new { id = Model.CourseID }) |
    @Html.ActionLink("Back to List", "Index")
</p>
