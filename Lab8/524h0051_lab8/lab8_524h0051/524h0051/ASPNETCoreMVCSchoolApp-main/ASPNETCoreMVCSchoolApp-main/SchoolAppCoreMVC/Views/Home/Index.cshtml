@{
    ViewData["Title"] = "Home";
}
<div class="text-center my-4">
    <h1 class="display-5">School Management (MVC)</h1>
    <p>ASP.NET Core MVC + Entity Framework Core - Database First (SchoolDB)</p>
</div>
<div class="row">
        <div class="col-md-4 mb-3"><div class="card h-100"><div class="card-body"><h5 class="card-title">Departments</h5><a class="btn btn-outline-primary" asp-controller="Departments" asp-action="Index">Manage Departments</a></div></div></div>
        <div class="col-md-4 mb-3"><div class="card h-100"><div class="card-body"><h5 class="card-title">Instructors</h5><a class="btn btn-outline-primary" asp-controller="Instructors" asp-action="Index">Manage Instructors</a></div></div></div>
        <div class="col-md-4 mb-3"><div class="card h-100"><div class="card-body"><h5 class="card-title">Courses</h5><a class="btn btn-outline-primary" asp-controller="Courses" asp-action="Index">Manage Courses</a></div></div></div>
        <div class="col-md-4 mb-3"><div class="card h-100"><div class="card-body"><h5 class="card-title">Students</h5><a class="btn btn-outline-primary" asp-controller="Students" asp-action="Index">Manage Students</a></div></div></div>
        <div class="col-md-4 mb-3"><div class="card h-100"><div class="card-body"><h5 class="card-title">Enrollments</h5><a class="btn btn-outline-primary" asp-controller="Enrollments" asp-action="Index">Manage Enrollments</a></div></div></div>
        <div class="col-md-4 mb-3"><div class="card h-100"><div class="card-body"><h5 class="card-title">Report (.rdlc)</h5><a class="btn btn-outline-success" asp-controller="Reports" asp-action="Index">Enrollment report</a></div></div></div>
</div>
